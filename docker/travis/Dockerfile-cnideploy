ARG GO_VERSION=1.26.10
FROM registry.access.redhat.com/ubi9/ubi:latest AS cni-builder
ARG GO_VERSION
ARG GO_SHA256=ccfe7ae822d2c2f41f4fe7c956199967a4dac22d0ee0d2b2bfdb440aab3b20c5
ARG CNI_PLUGINS_REPO=github.com/containernetworking/plugins
ARG CNI_PLUGINS_COMMIT=5ed4cbb08c95f1797fc948993c1235ff8921b580
RUN yum install --disablerepo=* --enablerepo=ubi-9-appstream-rpms --enablerepo=ubi-9-baseos-rpms -y \
        ca-certificates curl-minimal git gzip tar \
    && yum clean all \
    && curl --fail --show-error --silent --location --retry 3 \
        --connect-timeout 10 --max-time 180 \
        "https://dl.google.com/go/go${GO_VERSION}.linux-amd64.tar.gz" -o /go-toolchain.tar.gz \
    && echo "${GO_SHA256}  /go-toolchain.tar.gz" | sha256sum --check - \
    && tar -C /usr/local -xzf /go-toolchain.tar.gz \
    && rm /go-toolchain.tar.gz
ENV PATH=/usr/local/go/bin:${PATH}
ENV GOTOOLCHAIN=local CGO_ENABLED=0 GOOS=linux GOARCH=amd64
RUN git clone --no-checkout "https://${CNI_PLUGINS_REPO}.git" /src/plugins
WORKDIR /src/plugins
# Keep release ancestry so Go derives the correct main-module pseudo-version.
RUN git checkout --detach "${CNI_PLUGINS_COMMIT}" \
    && test "$(git rev-parse HEAD)" = "${CNI_PLUGINS_COMMIT}" \
    && test "$(go env GOVERSION)" = "go${GO_VERSION}" \
    && PLUGINS=plugins/main/loopback ./build_linux.sh -trimpath \
        -ldflags "-X github.com/containernetworking/plugins/pkg/utils/buildversion.BuildVersion=${CNI_PLUGINS_REPO}@${CNI_PLUGINS_COMMIT}" \
    && go version -m bin/loopback

FROM registry.access.redhat.com/ubi9/ubi:latest
# Required OpenShift Labels
LABEL name="ACI CNI cnideploy" \
maintainer="Vishal Lella <vlella@cisco.com>" \
vendor="Cisco" \
version="v1.1.0" \
release="1" \
summary="This is an ACI CNI cnideploy." \
description="This operator will deploy a single instance of ACI CNI cnideploy."
RUN yum update --disablerepo=* --enablerepo=ubi-9-appstream-rpms --enablerepo=ubi-9-baseos-rpms -y && rm -rf /var/cache/yum
# Required Licenses
COPY docker/licenses /licenses
# Only loopback is installed by launch-cnideploy.sh; build tools stay above.
COPY --from=cni-builder /src/plugins/bin/loopback /opt/cni/bin/loopback
COPY --from=cni-builder /src/plugins/LICENSE /src/plugins/README.md /opt/cni/bin/
COPY docker/launch-cnideploy.sh /usr/local/bin/
CMD ["/usr/local/bin/launch-cnideploy.sh"]
